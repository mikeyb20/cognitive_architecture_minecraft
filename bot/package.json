{
  "name": "cognitive-architecture-minecraft-bot",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript Mineflayer adapter implementing the Host contract (spec §22).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 --test-coverage-exclude='dist/**/*.test.js' --test-coverage-exclude='dist/mineflayer/**' 'dist/**/*.test.js'"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@types/node": "22.19.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-armor-manager": "2.0.1",
    "mineflayer-auto-eat": "5.0.3",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2"
  }
}
